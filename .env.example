# ================================================================
# Fazi Awan Portfolio — Environment Variables
# ================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# On Vercel: set these under Project → Settings → Environment Variables
# ================================================================

# ── Contact Form ────────────────────────────────────────────────
# The endpoint your contact form POSTs to.
# Options:
#   - Formspree: https://formspree.io/f/<your-form-id>
#   - Netlify Forms (not applicable on Vercel)
#   - Your own serverless API route
#
# Leave empty to run in demo mode (simulated success, no real POST).
CONTACT_ENDPOINT=

# ── Analytics (optional) ────────────────────────────────────────
# Vercel Analytics is zero-config — just enable it in your Vercel dashboard.
# For Google Analytics 4, paste your Measurement ID here:
GA_MEASUREMENT_ID=

# ── Social Links (optional personalisation) ───────────────────
# Populate these if you plan to build a server-side version later.
GITHUB_URL=https://github.com/yourusername
LINKEDIN_URL=https://linkedin.com/in/yourusername
TWITTER_URL=https://twitter.com/yourusername

# ── Site Metadata ───────────────────────────────────────────────
SITE_URL=https://your-domain.vercel.app
SITE_NAME=Fazi Awan — Portfolio
